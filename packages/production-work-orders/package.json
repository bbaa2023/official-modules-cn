{
  "name": "@open-mercato/production-work-orders",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    }
  },
  "peerDependencies": {
    "@mikro-orm/postgresql": "^7.0.13",
    "@open-mercato/ai-assistant": "0.6.0",
    "@open-mercato/core": "0.6.0",
    "@open-mercato/shared": "0.6.0",
    "@open-mercato/ui": "0.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": ">=3.23.0"
  },
  "devDependencies": {
    "@mikro-orm/decorators": "^7.0.13",
    "@open-mercato/ai-assistant": "0.6.0",
    "@open-mercato/core": "0.6.0",
    "@open-mercato/shared": "0.6.0",
    "@open-mercato/ui": "0.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "jest": "^30.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
